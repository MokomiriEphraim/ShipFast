# OpenAI API Key (Required for GPT-4o-mini text & DALL-E image generation)
OPENAI_API_KEY=sk-proj-your-openai-key-here

# Gemini API Key (Optional fallback for text & image generation)
GEMINI_API_KEY=your-gemini-key-here

# MongoDB Connection String (Optional for history, settings, and stats persistence)
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/database

# Port for local dev server (Defaults to 3000)
PORT=3000
